{
  "name": "kingdom-engagements-client",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:production": "ng build --configuration production && npm run build:host-realtime",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "build:host-realtime": "esbuild src/host-realtime.ts --bundle --minify --format=iife --outfile=../wwwroot/host-realtime.js"
  },
  "dependencies": {
    "@angular/common": "21.2.0",
    "@angular/compiler": "21.2.0",
    "@angular/core": "21.2.0",
    "@angular/forms": "21.2.0",
    "@angular/platform-browser": "21.2.0",
    "@angular/router": "21.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "@microsoft/signalr": "10.0.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.2",
    "vitest": "4.0.8",
    "esbuild": "0.25.10"
  }
}
