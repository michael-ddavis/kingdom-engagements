<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KingdomEngagements.Web</RootNamespace>
    <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
  </ItemGroup>

  <Target
    Name="BuildAngularForPublish"
    BeforeTargets="Publish"
    Condition="'$(Configuration)' == 'Release' and '$(BuildAngular)' != 'false'">
    <Message Importance="high" Text="Building Kingdom Engagements Angular application..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:production" />

    <ItemGroup>
      <ClientAppAssets Include="$(SpaRoot)dist\ClientApp\browser\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(ClientAppAssets)"
      DestinationFiles="@(ClientAppAssets->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
