{
  "Database": {
    "Provider": "SqlServer",
    "RequireRelational": true
  },
  "KingdomOS": {
    "Entitlements": {
      "BypassInDevelopment": false,
      "FailOpenInDevelopment": false
    },
    "HostAccess": {
      "LegacyTokenRoutesEnabled": false
    },
    "Identity": {
      "DemoProfilesEnabled": false
    },
    "DistributedRuntime": {
      "RequireRedis": true
    },
    "DocumentStorage": {
      "Provider": "S3"
    },
    "Secrets": {
      "Directory": "/run/secrets"
    },
    "Observability": {
      "JsonConsole": true,
      "RequireExporter": true,
      "ServiceName": "apostolos-engagements"
    },
    "TenantRouting": {
      "DefaultPublicInvitationTenantId": "",
      "HickmanPublicInvitationTenantId": "",
      "ReadinessTenantId": ""
    }
  }
}
